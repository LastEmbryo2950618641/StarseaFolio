{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "electron", "vite/client", "vitest/globals"]
  },
  "include": [
    "win/**/*.ts",
    "win/**/*.tsx",
    "android/**/*.ts",
    "android/**/*.tsx",
    "common/**/*.ts",
    "common/**/*.tsx",
    "vitest.config.ts"
  ]
}
